# The image goreleaser builds. It copies the binary goreleaser already produced
# rather than compiling again, so the released binary and the one in the image
# are the same bytes.
#
# goreleaser stages a context laid out by platform -- linux/amd64/blindbucket,
# linux/arm64/blindbucket -- and buildx sets TARGETPLATFORM per architecture, so
# one Dockerfile covers both. Copying plain "blindbucket" from the context root
# is the obvious guess and fails: there is no such file.
#
# deploy/Dockerfile is the from-source equivalent, for building without
# goreleaser.
FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/blindbucket /blindbucket
USER 65532:65532
EXPOSE 9000 9100
ENTRYPOINT ["/blindbucket"]
CMD ["serve", "--config", "/etc/blindbucket/blindbucket.yaml"]
